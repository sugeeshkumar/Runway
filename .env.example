# ==========================================
# RUNWAY ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local deployment
# ==========================================

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/runway_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2

# Security & Authentication (Generate a 256-bit hex string for production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# CORS Allowed Origins (Comma-separated for multi-origin deployments)
RUNWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Server Port
PORT=8080

# Frontend API Base URL
VITE_API_URL=http://localhost:8080/api/v1
