# ==========================================
# RUNWAY FRONTEND ENVIRONMENT CONFIGURATION
# Copy to frontend/.env.local for local development
# ==========================================

# API Base URL for backend communications
# Note: For production deployment (e.g. Render/Vercel), set this to your backend domain.
# Example: https://runway-backend-kq4y.onrender.com/api/v1
VITE_API_URL=http://localhost:8080/api/v1
